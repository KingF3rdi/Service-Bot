# Pflicht
TOKEN=

# Optional: Haupt-Server (Website-Standard, .env-Fallback für Kanäle/Rollen).
# Der Bot läuft auf ALLEN Servern, auf die er eingeladen ist – jeder mit eigenen Daten.
GUILD_ID=
# Optional: welcher Server auf der Website angezeigt wird (sonst GUILD_ID)
WEB_GUILD_ID=

# Website
WEB_PORT=3000
DISCORD_INVITE=https://discord.gg/DEINCODE

# Optional: Logo für Embed-Footer
LOGO_URL=

# Kanäle & Rollen stellst du am einfachsten per /setup in Discord ein.
# Werte hier gelten nur für den GUILD_ID-Server, solange per /setup nichts gesetzt ist.
TICKET_CATEGORY_ID=
VOUCH_CHANNEL_ID=
MAPART_ROLE_ID=
SPAWNER_ROLE_ID=
SCHEMATIC_ROLE_ID=
MOD_ROLE_ID=
WATERMARK_ROLE_ID=
SUPPORT_ROLE_ID=
